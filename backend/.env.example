# Copy to backend/.env (gitignored). This file is read only by the Python backend.
# Keep provider credentials on the backend; never put them in the Next.js app or
# in any NEXT_PUBLIC_* variable.

# OpenAI is the default provider. New agent sessions require a key and live mode.
# The legacy planner alone supports automatic rule-based mock mode.
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_MAX_TOKENS=1024
OPENAI_TIMEOUT_S=60
# auto = mock when key is missing; true = always mock; false = fail if key missing
OPENAI_MOCK=auto
# none keeps reasoning tokens off for lower usage
OPENAI_REASONING_EFFORT=none

# New ASHA-reviewed agent-loop limits (no automatic SDK retries)
AGENT_TURN_MAX_CALLS=4
AGENT_SESSION_MAX_CALLS=24
AGENT_MAX_OUTPUT_TOKENS=1800
AGENT_TIMEOUT_S=20

# Complete batch quiz drafts (attempts make no OpenAI calls)
QUIZ_MAX_OUTPUT_TOKENS=4000
QUIZ_MAX_QUESTIONS=10

# Optional Bedrock configuration. Set LLM_PROVIDER=bedrock to use it.
# Credentials: prefer `aws configure` / AWS_PROFILE / an IAM role over keys here.
AWS_REGION=us-east-1
BEDROCK_MODEL=nova-pro
BEDROCK_MOCK=auto
BEDROCK_MAX_TOKENS=1024
BEDROCK_TIMEOUT_S=60
# AWS_PROFILE=default

FRONTEND_ORIGIN=http://localhost:3000
