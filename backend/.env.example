# copy to backend/.env (gitignored). This file is read ONLY by the Python backend.
# Never put AWS values in the Next.js app or in any NEXT_PUBLIC_* variable.

AWS_REGION=us-east-1

# nova-pro | nova-lite | nova-micro | claude-sonnet-4 | claude-3.5-sonnet (EOL), or a full model / inference profile id
# check a model is still active: aws bedrock get-foundation-model --model-identifier amazon.nova-pro-v1:0 --query modelDetails.modelLifecycle
BEDROCK_MODEL=nova-pro

# auto = mock when no AWS credentials are found, true = always mock, false = always call Bedrock
BEDROCK_MOCK=auto

BEDROCK_MAX_TOKENS=1024
BEDROCK_TIMEOUT_S=60
FRONTEND_ORIGIN=http://localhost:3000

# Credentials: prefer `aws configure` / AWS_PROFILE / an IAM role over keys in this file.
# AWS_PROFILE=default
