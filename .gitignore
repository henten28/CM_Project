# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# environment files (only the blank backend example is tracked)
.env*
!backend/.env.example
backend/.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# python test and bytecode caches
__pycache__/
.pytest_cache/
**/.venv/

# Local knowledge corpus (curated seed files are explicitly tracked below)
backend/knowledge/sources.json
backend/knowledge/documents/*
!backend/knowledge/documents/.gitkeep
!backend/knowledge/documents/cdc-amr-basics.md

# local database files and SQLite journals
*.db
*.db-*
*.sqlite
*.sqlite3
*.sqlite-*
*.sqlite3-*
